---
// Vorka — "El sistema Vorka" (Fase 3 del rediseño 2026-07, PROMPT MAESTRO).
// Dos secciones scroll-driven estilo Apple: <canvas> + secuencia de frames
// WebP (public/frames/<seq>/{desktop,mobile}/) pintada por ScrollSequence
// (src/lib/scrollSequence.ts, GSAP ScrollTrigger, mode 'scrub' = pinned).
// Visuales abstractos oscuros en la paleta de marca de Vorka — nunca texto
// renderizado por el modelo de video (poco confiable); el copy real vive en
// <h3>/<p> normales dentro de .seq-overlay, server-rendered por Astro, así
// que queda indexable con o sin JS (ver Fase 4, verificación de
// indexabilidad de estos overlays).
---

<section class="sistema" aria-label="Cómo funciona Vorka">
  <div class="container sistema__intro">
    {/* Sprint 1 T1 (2026-07-23): el eyebrow "Cómo funciona" vive ahora solo
        en Servicios.astro (la sección de los 3 pasos) — aquí era una segunda
        aparición de la misma etiqueta. */}
    <p class="sistema__eyebrow reveal">El sistema, en movimiento</p>
    <h2 class="section-title reveal">El sistema Vorka, de principio a fin</h2>
  </div>

  <div class="seq" id="seq-construccion" data-seq>
    <canvas aria-hidden="true"></canvas>
    <div class="seq-overlay">
      {/* Sprint 3 T1 — un beat cubre toda la escena de construcción (0→1). */}
      <div class="seq-beat is-active" data-beat data-from="0">
        <h3 class="seq-titulo">Tu negocio, convertido en una web que vende</h3>
        <p class="seq-texto">
          Estructura, diseño y contenido reales de tu negocio — listos en 5–7 días, no en meses.
        </p>
      </div>
    </div>
  </div>

  <div class="seq" id="seq-conversion" data-seq>
    <canvas aria-hidden="true"></canvas>
    <div class="seq-overlay">
      {/* Sprint 3 T1 — la escena de conversión lleva DOS beats que se cruzan a
          mitad de su progreso: WhatsApp→pedido (0→0.5) y el cierre Ordercash
          (0.5→1). El engine (scrollSequence.ts) ya expone onProgress; el script
          de abajo enciende el beat correcto según ese progreso. */}
      <div class="seq-beat is-active" data-beat data-from="0">
        <h3 class="seq-titulo">De un mensaje de WhatsApp a un pedido confirmado</h3>
        <p class="seq-texto">
          Cada visita a tu web se conecta directo con tu WhatsApp — sin apps que instalar, sin
          fricción para tu cliente.
        </p>
      </div>
      <div class="seq-beat" data-beat data-from="0.5">
        <h3 class="seq-titulo">Cobrado y facturado, automático con Ordercash</h3>
        <p class="seq-texto">
          Tú confirmas y Ordercash cobra y emite la factura SRI. Tu web queda lista para dar el
          salto apenas Ordercash esté disponible para tu negocio.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { ScrollSequence } from '@/lib/scrollSequence';

  const BASE = import.meta.env.BASE_URL;

  // Sprint 1 T2 (2026-07-23): antes eran 2 secuencias de pinVh 250 (~500vh de
  // scroll anclado en total) — la sección ocupaba demasiados viewports. Ahora:
  //  · desktop: pinVh 120 por escena (~240vh total, la mitad y algo menos);
  //  · móvil: NO se ejecuta el scroll-scrubbing (pin + scroll táctil es jankoso
  //    y descargaría 100 frames por escena). Solo el poster estático; el copy
  //    del overlay ya es server-rendered, así que queda visible e indexable.
  const isMobile = window.matchMedia('(max-width: 768px)').matches;

  const escenas = [
    { id: 'seq-construccion', name: 'construccion' },
    { id: 'seq-conversion', name: 'conversion' },
  ];

  // Sprint 3 T1 — sincroniza el texto del overlay con el progreso del scroll:
  // enciende el ÚLTIMO beat cuyo data-from ya alcanzó el progreso actual. Los
  // beats se solapan en el mismo punto del overlay y hacen crossfade por CSS
  // (solo opacity/transform). En móvil y reduced-motion no se llama nunca —
  // el CSS de .seq-static deja los beats como lista estática legible.
  const sincronizarBeats = (section: HTMLElement, progress: number) => {
    const beats = Array.from(section.querySelectorAll<HTMLElement>('[data-beat]'));
    let activo = 0;
    beats.forEach((beat, i) => {
      if (progress >= Number(beat.dataset.from)) activo = i;
    });
    beats.forEach((beat, i) => beat.classList.toggle('is-active', i === activo));
  };

  for (const { id, name } of escenas) {
    const section = document.getElementById(id);
    if (!section) continue;
    const variant = isMobile ? 'mobile' : 'desktop';
    const posterSrc = `${BASE}frames/${name}/${variant}/frame-0001.webp`;

    if (isMobile) {
      section.querySelector('canvas')?.remove();
      const img = new Image();
      img.src = posterSrc;
      img.alt = '';
      img.loading = 'lazy';
      img.className = 'seq-fallback';
      section.prepend(img);
      section.classList.add('seq-static');
      continue;
    }

    new ScrollSequence({
      section,
      seqName: name,
      frameCount: 100,
      mode: 'scrub',
      pinVh: 120,
      posterSrc,
      onProgress: (progress) => sincronizarBeats(section, progress),
    });
  }
</script>

<style>
  .sistema {
    background: var(--bg-0);
  }

  .sistema__intro {
    /* Sprint 3.1 T4: solo padding inferior. La sección anterior (Servicios,
       .section) ya aporta su padding inferior; sumar aquí el padding superior
       apilaba dos ritmos de sección (~80–112px) y dejaba un gap excesivo antes
       del video. Un solo gap de sección estándar, alineado a 8px. */
    padding: 0 0 var(--section-pad);
    text-align: center;
  }

  .sistema__eyebrow {
    font-family: var(--font-texto);
    font-weight: 600;
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primario);
    margin: 0 0 12px;
  }

  .seq {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: #0d0d0d;
  }

  .seq + .seq {
    margin-top: 2px;
  }

  .seq canvas {
    position: absolute;
    inset: 0;
    /* Contención (2026-07-29): la fuente de video es 720p (1280×810 real). A
       pantalla completa se estiraba 1.5–3x y se veía pixelada. Se centra el
       canvas en una banda de máx. 1440px (= ancho de los frames → 1:1 en
       monitores DPR-1, sin upscale del navegador); el fondo #0d0d0d de .seq
       hace de letterbox a los lados. La nitidez total edge-to-edge requiere
       regenerar la fuente a ≥1080p (ver docs/vorka-backlog.md). */
    max-width: 1440px;
    margin-inline: auto;
    width: 100%;
    height: 100%;
    display: block;
  }

  .seq-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seq-overlay {
    position: absolute;
    inset: 0;
    /* Alineado a la misma banda de 1440px que el canvas (ver .seq canvas): así
       el texto y el degradado quedan sobre el video, no sobre el letterbox. */
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--section-pad);
    background: linear-gradient(to top, rgba(13, 13, 13, 0.75), transparent 55%);
    color: var(--color-texto);
    pointer-events: none;
  }

  .seq-titulo {
    font-family: var(--font-titulos);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, var(--t-2xl));
    line-height: 1.15;
    max-width: 20ch;
    margin: 0 0 12px;
  }

  .seq-texto {
    font-family: var(--font-texto);
    font-size: var(--t-md);
    line-height: 1.6;
    max-width: 48ch;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  /* Sprint 3 T1 — beats del overlay. En modo scrub (desktop) se apilan en el
     mismo punto inferior del overlay y hacen crossfade según el progreso: el
     activo entra, el resto sale. Solo opacity/transform (regla innegociable).
     El estado base oculto lo controla is-active desde el script; el primer
     beat de cada escena nace con is-active en el HTML para no dejar el overlay
     en blanco antes del primer onProgress. */
  .seq-beat {
    position: absolute;
    left: var(--section-pad);
    right: var(--section-pad);
    bottom: var(--section-pad);
    opacity: 0;
  }

  .seq-beat.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .seq-beat {
      transform: translateY(14px);
      transition: opacity var(--duration-reveal) var(--ease-out-expo),
        transform var(--duration-reveal) var(--ease-out-expo);
    }

    .seq-beat.is-active {
      transform: translateY(0);
    }
  }

  /* Estado estático (móvil + prefers-reduced-motion): el engine añade
     .seq-static y NO hay scrubbing. El overlay pasa a flujo normal y los beats
     se muestran TODOS como una lista legible sobre el poster — así los 3
     textos quedan visibles sin animación, como exige la spec para
     reduced-motion. */
  .seq-static {
    height: auto;
    min-height: 60vh;
    overflow: visible;
  }

  .seq-static .seq-overlay {
    position: relative;
    justify-content: flex-end;
    gap: 20px;
    padding-block: 56px;
  }

  .seq-static .seq-beat {
    position: static;
    opacity: 1;
    transform: none;
  }

  .seq-hud {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.7);
    color: #39d353;
    font: 13px/1.4 monospace;
    border-radius: var(--r-sm);
    z-index: 10;
  }

  @media (max-width: 768px) {
    .seq {
      height: 100svh;
    }

    /* Sprint 1 T2: en móvil la escena es un poster estático, no un scroll
       anclado — no necesita ocupar toda la pantalla. Sprint 3 T1: alto
       automático (min 46svh) para que la escena de conversión, que ahora lista
       DOS beats, no recorte el segundo contra el borde inferior. */
    .seq-static {
      height: auto;
      min-height: 46svh;
    }

    .seq-overlay {
      padding: 24px;
    }
  }
</style>
