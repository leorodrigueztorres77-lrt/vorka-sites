---
// Vorka — Anchor de valor (spec GTM de Leo 2026-07, Fase 6; reencuadrado en
// Sprint 1 T5, 2026-07-23). Una sola tabla: el status quo del prospecto (solo
// redes / sin web) contra tener su web con Vorka. Habla del dolor actual del
// dueño (no aparece en Google, pierde pedidos en DMs), que es lo que de verdad
// mueve la decisión, y es válido para cualquier vertical (restaurante,
// consultorio, comercio) — no cierra la puerta a ningún tipo de negocio.
//
// En mobile colapsa a cards apiladas (NUNCA tabla horizontal con scroll, regla
// de la spec).
//
// (2026-07-31) Se retiró la 2ª tabla "Ordercash vs. apps de delivery": por
// decisión de Leo el GTM vuelve a ser multi-vertical y no se ancla al argumento
// de comisiones de delivery. La fila de Ordercash aquí mantiene el framing del
// sistema, sin promesa de fecha.
import { buildWhatsAppLink } from '@/lib/whatsapp';
import type { SiteConfig } from '@/data/types';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;

const href = buildWhatsAppLink({
  phone: site.telefonoWhatsApp,
  message: 'Hola Vorka, quiero información para mi negocio',
  negocioSlug: site.negocioSlug,
});

const filas = [
  { concepto: 'Te encuentran en Google', actual: 'No apareces', vorka: 'Apareces con SEO local' },
  { concepto: 'Pedidos y consultas', actual: 'Se pierden en los DMs', vorka: 'Llegan directo a tu WhatsApp' },
  { concepto: 'Facturación SRI', actual: 'Manual, uno por uno', vorka: 'Automatizada con Ordercash' },
  { concepto: 'Imagen profesional', actual: 'Dependes del feed', vorka: 'Web propia que vende 24/7' },
  { concepto: 'Costo de empezar', actual: '"Gratis", pero te cuesta ventas', vorka: 'Desde $249, fijo' },
];
---

<section class="comparativa section" id="comparativa">
  <div class="container comparativa__inner">
    <h2 class="section-title reveal">Seguir como estás vs. tener tu web con Vorka</h2>

    {/* Sprint 2 T1: cada fila de datos lleva su propio .reveal para que la
        cascada de Capa 1 las anime una tras otra; la cabecera queda como marco
        estático. */}
    <div class="comparativa__tabla" role="table" aria-label="Comparación entre seguir sin web y tener tu web con Vorka">
      <div class="comparativa__fila comparativa__fila--cabecera" role="row">
        <span role="columnheader"></span>
        <span role="columnheader">Solo redes / sin web</span>
        <span role="columnheader" class="comparativa__col-vorka">Con Vorka</span>
      </div>
      {filas.map((fila) => (
        <div class="comparativa__fila reveal" role="row">
          <span class="comparativa__concepto" role="rowheader">{fila.concepto}</span>
          <span class="comparativa__valor" role="cell">
            <span class="comparativa__etiqueta" aria-hidden="true">Solo redes / sin web</span>
            {fila.actual}
          </span>
          <span class="comparativa__valor comparativa__valor--vorka" role="cell">
            <span class="comparativa__etiqueta" aria-hidden="true">Con Vorka</span>
            {fila.vorka} <span class="comparativa__check" aria-hidden="true">✓</span>
          </span>
        </div>
      ))}
    </div>

    <a class="btn btn--primario reveal" href={href} target="_blank" rel="noopener noreferrer">
      Hablemos por WhatsApp <span class="btn__flecha" aria-hidden="true">→</span>
    </a>
    <p class="comparativa__subtext reveal">Sin compromiso. Respuesta en menos de 2 horas.</p>
  </div>
</section>

<style>
  .comparativa {
    background: var(--color-fondo);
  }

  .comparativa__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .comparativa__tabla {
    width: 100%;
    max-width: 860px;
    margin: 8px 0 32px;
    border: 1px solid var(--border-default);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .comparativa__fila {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr;
    gap: 8px;
    padding: 14px 24px;
    align-items: center;
  }

  .comparativa__fila:nth-child(even) {
    background: var(--color-fondo-alterno);
  }

  .comparativa__fila--cabecera {
    background: var(--color-fondo-alterno);
    font-family: var(--font-texto);
    font-weight: 700;
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gris);
  }

  .comparativa__col-vorka {
    color: var(--color-primario);
  }

  .comparativa__concepto {
    font-family: var(--font-texto);
    font-weight: 600;
    font-size: var(--t-sm);
    color: var(--color-texto);
  }

  .comparativa__valor {
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-gris);
  }

  .comparativa__valor--vorka {
    color: var(--color-texto);
    font-weight: 600;
  }

  .comparativa__check {
    color: var(--color-primario);
    font-weight: 700;
  }

  /* Etiquetas solo visibles en el layout apilado de mobile. */
  .comparativa__etiqueta {
    display: none;
  }

  .comparativa__subtext {
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-gris);
    margin: 12px 0 0;
  }

  .comparativa .btn--primario {
    margin-top: 8px;
  }

  @media (max-width: 720px) {
    .comparativa__fila--cabecera {
      display: none;
    }

    .comparativa__fila {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 20px 24px;
    }

    .comparativa__concepto {
      font-size: var(--t-base);
      margin-bottom: 2px;
    }

    .comparativa__etiqueta {
      display: block;
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-gris);
      opacity: 0.7;
    }

    .comparativa__valor--vorka .comparativa__etiqueta {
      color: var(--color-primario);
      opacity: 1;
    }
  }
</style>
