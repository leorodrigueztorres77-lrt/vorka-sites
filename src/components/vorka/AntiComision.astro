---
// Vorka — Sección anti-comisión (spec GTM de Leo, v3 · Sección 5). Es el
// gatillo emocional más fuerte del pitch para restaurantes y negocios con
// delivery: muestra dinero que el dueño YA está perdiendo cada mes en
// comisiones de PedidosYa, contra el costo fijo de Ordercash. La calculadora
// es estática (3 escenarios hardcodeados con las cifras validadas del spec),
// sin input del usuario en esta versión.
//
// FRAMING ORDERCASH (decisión Leo 2026-07): Ordercash es coming-soon/preventa,
// NO se promete disponible hoy. El precio mostrado es "de lanzamiento" y el CTA
// reserva un cupo, sin prometer factura SRI activa todavía (regla del CLAUDE.md
// "nunca prometer una integración que no existe"). El ahorro sigue siendo real
// como argumento; lo único que se etiqueta es la disponibilidad.
//
// Tratamiento visual diferenciado (spec: "fondo oscuro o color de acento"):
// como todo el sitio ya es #1A1A1A, esta sección va casi-negra con un halo
// verde de marca para leerse como un momento aparte del ritmo del resto.
import { buildWhatsAppLink } from '@/lib/whatsapp';
import type { SiteConfig } from '@/data/types';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;

const href = buildWhatsAppLink({
  phone: site.telefonoWhatsApp,
  message: 'Hola Vorka, quiero reservar mi cupo de Ordercash para mi negocio',
  negocioSlug: site.negocioSlug,
});

// Cifras oficiales del spec v3 (validadas contra el mercado Ecuador 2026).
// PedidosYa: ~13% + IVA con logística propia. Ordercash Pro: $89/mes de
// lanzamiento. No recalcular aquí: son los números que Leo aprobó.
const escenarios = [
  { ventas: '$1.500', pedidosya: '$219', ordercash: '$89', ahorroMes: '$130', ahorroAnio: '$1.560' },
  { ventas: '$2.500', pedidosya: '$365', ordercash: '$89', ahorroMes: '$276', ahorroAnio: '$3.312', popular: true },
  { ventas: '$4.000', pedidosya: '$584', ordercash: '$89', ahorroMes: '$495', ahorroAnio: '$5.940' },
];
---

<section class="anticom section" id="anti-comision">
  <div class="container anticom__inner">
    <p class="anticom__eyebrow reveal">Para negocios con delivery</p>
    <h2 class="section-title anticom__titulo reveal">¿Cuánto le estás pagando a PedidosYa este mes?</h2>
    <p class="anticom__intro reveal">
      Cada pedido que entra por una app de terceros se lleva una tajada. Mira lo que costaría
      lo mismo con un canal directo tuyo.
    </p>

    <div class="anticom__grid">
      {escenarios.map((e) => (
        <article class={`anticom__card reveal${e.popular ? ' anticom__card--destacada' : ''}`}>
          <p class="anticom__ventas">
            Ventas por delivery
            <strong>{e.ventas}<span>/mes</span></strong>
          </p>
          <dl class="anticom__comparacion">
            <div class="anticom__linea anticom__linea--costo">
              <dt>Con PedidosYa</dt>
              <dd>{e.pedidosya}<span>/mes</span></dd>
            </div>
            <div class="anticom__linea anticom__linea--ahorro">
              <dt>Con Ordercash</dt>
              <dd>{e.ordercash}<span>/mes</span></dd>
            </div>
          </dl>
          <div class="anticom__resultado">
            <span class="anticom__ahorro-mes">Ahorras {e.ahorroMes}/mes</span>
            <span class="anticom__ahorro-anio">{e.ahorroAnio} al año</span>
          </div>
        </article>
      ))}
    </div>

    <p class="anticom__nota reveal">
      Comisión PedidosYa Ecuador aproximada: 13% más IVA con logística propia. Fuente: condiciones
      publicadas por la plataforma, 2026. Cifras ilustrativas.
    </p>

    <p class="anticom__aclaracion reveal">
      Ordercash no reemplaza a PedidosYa para captar clientes nuevos. Lo reemplaza para tus clientes
      recurrentes, los que ya te conocen y solo necesitan un canal directo para volver a pedirte.
    </p>

    <div class="anticom__cierre reveal">
      <span class="anticom__badge">Próximamente</span>
      <a class="btn btn--primario" href={href} target="_blank" rel="noopener noreferrer">
        Reserva tu cupo de Ordercash <span class="btn__flecha" aria-hidden="true">→</span>
      </a>
      <p class="anticom__subtext">
        Precio de lanzamiento: $89/mes, setup único de $99, sin permanencia. Te avisamos apenas esté disponible.
      </p>
    </div>
  </div>
</section>

<style>
  /* Casi-negro con halo verde: la diferencia respecto al #1A1A1A / #333 del
     resto marca esta sección como su propia propuesta de valor. */
  .anticom {
    background:
      radial-gradient(120% 90% at 50% -10%, rgba(57, 211, 83, 0.14), transparent 60%),
      #0f0f0f;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .anticom__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .anticom__eyebrow {
    font-family: var(--font-texto);
    font-weight: 700;
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-secondary);
    margin: 0 0 12px;
  }

  .anticom__titulo {
    max-width: 720px;
  }

  .anticom__intro {
    font-family: var(--font-texto);
    font-size: var(--t-base);
    color: var(--color-gris);
    max-width: 560px;
    margin: 16px 0 40px;
  }

  .anticom__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    max-width: 960px;
    margin-bottom: 32px;
  }

  .anticom__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px 24px;
    background: var(--bg-1);
    border: 1px solid var(--border-default);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-elevar);
    text-align: left;
  }

  .anticom__card--destacada {
    border-color: var(--color-primario);
    box-shadow: var(--accent-glow);
  }

  .anticom__ventas {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-texto);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gris);
  }

  .anticom__ventas strong {
    font-family: var(--font-titulos);
    font-size: var(--t-xl);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-texto);
  }

  .anticom__ventas span {
    font-size: var(--t-md);
    font-weight: 600;
    color: var(--color-gris);
  }

  .anticom__comparacion {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 20px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .anticom__linea {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .anticom__linea dt {
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-gris);
  }

  .anticom__linea dd {
    margin: 0;
    font-family: var(--font-titulos);
    font-weight: 700;
    font-size: var(--t-md);
  }

  .anticom__linea dd span {
    font-size: var(--t-sm);
    font-weight: 600;
    opacity: 0.7;
  }

  .anticom__linea--costo dd {
    color: var(--color-gris);
    text-decoration: line-through;
    text-decoration-color: rgba(161, 161, 170, 0.6);
  }

  .anticom__linea--ahorro dd {
    color: var(--color-primario);
  }

  .anticom__resultado {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .anticom__ahorro-mes {
    font-family: var(--font-titulos);
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--color-primario);
  }

  .anticom__ahorro-anio {
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-gris);
  }

  .anticom__nota {
    font-family: var(--font-texto);
    font-size: var(--t-xs);
    color: var(--color-gris);
    opacity: 0.75;
    max-width: 620px;
    margin: 0 0 24px;
  }

  .anticom__aclaracion {
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-texto);
    max-width: 620px;
    margin: 0 0 40px;
  }

  .anticom__cierre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .anticom__badge {
    font-family: var(--font-texto);
    font-weight: 700;
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primario);
    background: rgba(57, 211, 83, 0.12);
    border: 1px solid rgba(57, 211, 83, 0.4);
    border-radius: var(--r-full);
    padding: 6px 16px;
  }

  .anticom__subtext {
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-gris);
    max-width: 460px;
    margin: 0;
  }

  @media (max-width: 860px) {
    .anticom__grid {
      grid-template-columns: 1fr;
      max-width: 420px;
    }
  }
</style>
