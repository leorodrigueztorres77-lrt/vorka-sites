---
// Vorka — FAQ (spec GTM de Leo 2026-07, Fase 5): preguntas orientadas a
// cerrar objeciones reales de compra, copy genérico para cualquier negocio.
// GEO G3 (Sprint 3.1): varias respuestas nombran "Vorka" y la ciudad para que
// un fragmento citado por un motor de IA se sostenga solo fuera de contexto, y
// se agregó una pregunta de alta intención ("…una página web para un negocio
// en Quito"), que es la consulta exacta que reciben los motores generativos.
// El schema FAQPage se genera de este mismo array (no se desalinea del copy).
// Acordeón nativo <details>/<summary>, sin JS extra. Cifras alineadas al
// pricing vigente de CLAUDE.md y a la sección de Precios de esta misma
// página. Ordercash respeta el mensaje seguro ("queda preparada para
// conectar... apenas esté disponible") — nunca prometer una integración que
// no existe todavía. Las respuestas admiten HTML (links a demos en Q5).
export const preguntas = [
  {
    pregunta: '¿Cuánto cuesta y qué incluye?',
    respuesta:
      'Vorka trabaja desde $350: web lista en días, mobile first, WhatsApp como acción principal y SEO local. El plan Profesional ($500) suma galería optimizada, reseñas y Google Maps; el Premium (desde $750) suma formulario de pedidos, sección de producto en movimiento y sesión fotográfica. El mantenimiento mensual ($40 a $80) cubre cambios de contenido, reportes y soporte real, no es solo hosting.',
  },
  {
    pregunta: '¿Cuánto cuesta una página web para un negocio en Quito?',
    respuesta:
      'Vorka diseña páginas web para negocios locales en Quito y todo Ecuador desde $350, entregadas en 5 a 7 días. El precio depende del plan: $350 la Básica, $500 la Profesional y desde $750 la Premium. Aplica a restaurantes, consultorios médicos y dentales, y comercios en general — cada web es mobile first, con WhatsApp como acción principal y SEO local.',
  },
  {
    pregunta: 'Ya tengo Instagram. ¿Para qué necesito una web?',
    respuesta:
      'Instagram no te pertenece: mañana puede cambiar el algoritmo o suspender tu cuenta. Una web propia aparece en Google cuando alguien busca tu tipo de negocio en tu ciudad. Y con Ordercash, tu web conecta directo con pedidos, cobro y factura SRI, algo que Instagram nunca hará.',
  },
  {
    pregunta: '¿Cuánto tiempo toma tener mi web lista?',
    respuesta:
      'Vorka entrega tu web entre 2 y 7 días hábiles según el plan, desde que nos entregas tu logo, fotos y contenido. Si no tienes fotos o logo, te ayudamos: mejoramos tus fotos y te creamos una identidad básica de marca antes de empezar.',
  },
  {
    pregunta: '¿Qué es Ordercash y aplica a mi negocio?',
    respuesta:
      'Ordercash es nuestro producto de automatización de ventas: pedidos o reservas por WhatsApp, cobro integrado y factura electrónica SRI automática. Está diseñado para cualquier negocio que vende productos o servicios. Tu web Vorka queda preparada para conectarse con Ordercash desde el día uno, y te avisamos apenas esté disponible para tu tipo de negocio.',
  },
  {
    pregunta: '¿Puedo ver cómo quedaría mi negocio antes de pagar?',
    respuesta:
      'Sí, nuestros demos te muestran exactamente la experiencia que tendría tu cliente: <a href="/demo-sabor-de-los-andes/" target="_blank" rel="noopener noreferrer">Sabor de los Andes →</a> y <a href="/demo-brasas-del-valle/" target="_blank" rel="noopener noreferrer">Brasas del Valle →</a>. Si quieres ver cómo quedaría tu negocio específico, escríbenos por WhatsApp y te armamos una vista previa.',
  },
  {
    pregunta: '¿Qué pasa si quiero cambios después de lanzar?',
    respuesta:
      'El plan de mantenimiento mensual ($40 a $80) incluye cambios de contenido, reportes mensuales de tráfico y soporte por WhatsApp. No cobramos por cada cambio pequeño.',
  },
];
---

<section class="faq section section--alterno" id="faq">
  <div class="container">
    <h2 class="section-title reveal">Preguntas frecuentes</h2>
    <div class="faq__lista" data-faq>
      {preguntas.map((item) => (
        <details class="faq__item reveal">
          <summary class="faq__pregunta">
            <span class="faq__texto">{item.pregunta}</span>
            <span class="faq__icono" aria-hidden="true"></span>
          </summary>
          <div class="faq__respuesta-wrap">
            <p class="faq__respuesta" set:html={item.respuesta} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Sprint 2 T5 — enhancement del acordeón nativo <details>. Sin JS ya funciona
  // (semántica y teclado gratis, el CSS rota el ícono +→× vía [open]); esto
  // añade: (1) comportamiento de acordeón — al abrir uno se cierran los demás;
  // (2) aria-expanded sincronizado en cada summary; (3) cierre animado — el
  // navegador quita el contenido de <details> al instante, así que se
  // intercepta el click, se reproduce el fade-out y recién ahí se quita el
  // atributo open (apertura animada vía @starting-style, cierre rápido ~250ms).
  // Respeta prefers-reduced-motion: sin animación, alterna al instante.
  const lista = document.querySelector<HTMLElement>('[data-faq]');
  if (lista) {
    const items = Array.from(lista.querySelectorAll<HTMLDetailsElement>('.faq__item'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CIERRE_MS = 250;

    const sync = (item: HTMLDetailsElement) => {
      const s = item.querySelector('summary');
      s?.setAttribute('aria-expanded', String(item.open));
    };
    items.forEach(sync);

    const cerrar = (item: HTMLDetailsElement, animar: boolean) => {
      if (!item.open) return;
      if (animar && !reduce) {
        item.classList.add('is-closing');
        window.setTimeout(() => {
          item.open = false;
          item.classList.remove('is-closing');
          sync(item);
        }, CIERRE_MS);
      } else {
        item.open = false;
        sync(item);
      }
    };

    items.forEach((item) => {
      const summary = item.querySelector('summary');
      summary?.addEventListener('click', (e) => {
        if (item.open) {
          // Cierre: frenar el toggle nativo (instantáneo) y animar la salida.
          e.preventDefault();
          cerrar(item, true);
        } else {
          // Apertura: cerrar los hermanos abiertos y dejar que el toggle
          // nativo abra este (la entrada la anima @starting-style en el CSS).
          items.forEach((otro) => otro !== item && cerrar(otro, true));
        }
      });
      // Fuente de verdad final del estado (cubre togglear por teclado/programa).
      item.addEventListener('toggle', () => sync(item));
    });
  }
</script>

<style>
  .faq__lista {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
    margin: 0 auto;
  }

  .faq__item {
    padding: 20px 24px;
    border-radius: var(--r-md);
    background: var(--color-fondo);
    box-shadow: var(--shadow-elevar);
  }

  .faq__pregunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-titulos);
    font-weight: 700;
    font-size: var(--t-md);
    color: var(--color-texto);
    cursor: pointer;
    list-style: none;
  }

  .faq__pregunta::-webkit-details-marker {
    display: none;
  }

  .faq__pregunta:focus-visible {
    outline: 2px solid var(--color-primario);
    outline-offset: 4px;
    border-radius: var(--r-sm);
  }

  /* Ícono +/× dibujado con dos barras: en reposo es un "+", al abrir gira 45°
     y se convierte en "×" (solo transform — respeta la regla innegociable). */
  .faq__icono {
    position: relative;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  .faq__icono::before,
  .faq__icono::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-primario);
    border-radius: 1px;
  }

  .faq__icono::before {
    width: 14px;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .faq__icono::after {
    width: 2px;
    height: 14px;
    transform: translate(-50%, -50%);
  }

  .faq__item[open] .faq__icono {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__icono {
      transition: transform var(--duration-micro) var(--ease-out-expo);
    }
  }

  .faq__respuesta {
    margin: 12px 0 0;
    font-family: var(--font-texto);
    font-size: var(--t-base);
    line-height: 1.7;
    color: var(--color-gris);
  }

  /* Entrada/salida del contenido: opacity + translateY (nunca height). La
     apertura la dispara @starting-style (CSS puro, sin JS); el cierre lo anima
     el JS añadiendo .is-closing antes de quitar el atributo open. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__respuesta {
      transition: opacity var(--duration-micro) var(--ease-out-expo),
        transform var(--duration-micro) var(--ease-out-expo);
    }

    @starting-style {
      .faq__item[open] .faq__respuesta {
        opacity: 0;
        transform: translateY(-6px);
      }
    }

    .faq__item.is-closing .faq__respuesta {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /* Links dentro de respuestas insertadas con set:html. */
  .faq__respuesta :global(a) {
    color: var(--color-primario);
    text-decoration: none;
  }

  .faq__respuesta :global(a:hover) {
    text-decoration: underline;
  }
</style>
