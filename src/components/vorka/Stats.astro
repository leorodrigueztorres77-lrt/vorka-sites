---
// Vorka — Stats. Deliberadamente NO usa cifras de clientes/reseñas fabricadas
// (CLAUDE.md prohíbe inventar datos de reputación/fidelización) — son 4
// hechos verificables, reescritos en clave de beneficio para el cliente
// (corrección de Leo 2026-07: las métricas internas no le importan al dueño
// del negocio).
const stats = [
  { valor: '5–7 días', label: 'Entrega garantizada' },
  { valor: 'Desde $350', label: 'Sin costos ocultos' },
  { valor: 'A tu medida', label: 'Cualquier negocio, cualquier rubro' },
  // Sprint 1 T3b (2026-07-23): "100% WhatsApp" envolvía a 2 líneas y rompía la
  // línea base de la fila; la cifra pasa a "100%" y el label absorbe "WhatsApp
  // como CTA principal".
  { valor: '100%', label: 'WhatsApp como CTA principal' },
];

// Sprint 2 T3 — count-up. Se descompone cada cifra en prefijo + número + sufijo
// para animar SOLO el último entero (7, 350, 100) dejando fijo el texto que lo
// rodea ("5–", " días", "Desde $", "%"). "A tu medida" no tiene dígitos → queda
// estática (regla de Leo: animar texto no-numérico se ve forzado). El número
// final se renderiza tal cual en el HTML: es el valor real sin JS y el que ven
// prefers-reduced-motion y los lectores de pantalla; el count-up solo lo
// sobrescribe visualmente al entrar en viewport.
const parseValor = (valor: string) => {
  const m = valor.match(/^(.*?)(\d+)(\D*)$/);
  if (!m) return { estatico: valor };
  return { prefijo: m[1], objetivo: Number(m[2]), sufijo: m[3] };
};

const statsParsed = stats.map((s) => ({ ...s, num: parseValor(s.valor) }));
---

<section class="stats section">
  <div class="container">
    <ul class="stats__grid" data-stats>
      {statsParsed.map((stat) => (
        <li class="stats__item reveal--scale">
          <span class="stats__valor">
            {'estatico' in stat.num ? (
              stat.num.estatico
            ) : (
              <>
                {stat.num.prefijo}<span
                  class="stats__num"
                  data-count-to={stat.num.objetivo}
                >{stat.num.objetivo}</span>{stat.num.sufijo}
              </>
            )}
          </span>
          <span class="stats__label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Count-up progresivo: se dispara UNA vez cuando la fila entra en viewport.
  // Duración 700ms (bajo el techo de 800ms del sprint), easing out-expo, y
  // respeta prefers-reduced-motion (si el usuario lo pide, no anima: el HTML ya
  // trae el número final). Solo toca textContent de un <span> con
  // font-variant-numeric: tabular-nums, así el ancho por dígito es fijo y no hay
  // reflujo de los hermanos.
  const grid = document.querySelector<HTMLElement>('[data-stats]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (grid && !reduce && 'IntersectionObserver' in window) {
    const nums = Array.from(grid.querySelectorAll<HTMLElement>('.stats__num'));

    const animar = (el: HTMLElement) => {
      const objetivo = Number(el.dataset.countTo);
      if (!Number.isFinite(objetivo)) return;
      const duracion = 700;
      const inicio = performance.now();
      // easeOutExpo — mismo perfil que --ease-out-expo de la página.
      const ease = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));
      const paso = (ahora: number) => {
        const t = Math.min((ahora - inicio) / duracion, 1);
        el.textContent = String(Math.round(ease(t) * objetivo));
        if (t < 1) requestAnimationFrame(paso);
        else el.textContent = String(objetivo);
      };
      el.textContent = '0';
      requestAnimationFrame(paso);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animar(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 },
    );

    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  .stats {
    background: var(--color-fondo);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stats__valor {
    font-family: var(--font-titulos);
    font-weight: 700;
    font-size: var(--t-2xl);
    color: var(--color-primario);
    /* T3b: cifras con ancho tabular — misma línea base entre columnas y sin
       salto de layout cuando el count-up del Sprint 2 anime los dígitos. */
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .stats__label {
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-gris);
  }

  @media (max-width: 720px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
