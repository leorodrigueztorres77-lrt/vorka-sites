---
// Vorka — Hero (sitio propio de la agencia). Centrado, fondo oscuro con
// degradado sutil hacia --color-fondo-alterno (regla de profundidad visual
// #2, CLAUDE.md: bloque de color con peso, no plano). CTA único de WhatsApp
// como acción principal (misma jerarquía de CTA que el resto de Capa 1) +
// link secundario de scroll a Portafolio, sin competir en peso visual.
//
// Fase 2 (rediseño 2026-07) — el badge y el <h1> NO usaban .reveal de Capa 1
// para no retrasar el LCP (el fade opacity 0→1 esperaba al IntersectionObserver
// de BaseLayout).
//
// Sprint 2 T6 (2026-07-24) — entrada orquestada del hero. En vez del observer
// genérico, el hero corre su propia secuencia escalonada UNA vez al cargar
// (badge → titulo → sub → mockup → cta → proof), gateada por .js-reveal (que
// BaseLayout marca síncrono antes del primer pintado, así el estado inicial no
// parpadea) y disparada al añadir .is-ready. Dos piezas NO bajan nunca su
// opacity, solo se desplazan (translateY): el <h1> (candidato a LCP, debe
// pintarse visible ya) y el bloque .hero__cta que contiene el botón de WhatsApp
// (CTA sagrado: nunca oculto ni retrasado en visibilidad — se pinta clickeable
// desde el primer frame y solo se acomoda en posición). Sin JS todo queda
// visible; con prefers-reduced-motion no hay entrada.
import WhatsAppButton from '@/components/common/WhatsAppButton.astro';
import HeroPhonePreview from '@/components/vorka/HeroPhonePreview.astro';
import { siteConfigSaborAndes } from '@/data/site.sabor-de-los-andes';
import type { SiteConfig } from '@/data/types';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;

// La tarjeta de chat arranca sincronizada con el primer demo del preview (Sabor
// de los Andes) para que el SSR calce con el slide activo inicial; HeroPhonePreview
// la re-sincroniza por JS en cada rotación (decisión b de TAREA 1). Fuente de
// verdad = el site config del demo, no valores sueltos.
const chatDemoInicial = siteConfigSaborAndes;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__contenido">
      <span class="hero__badge">Agencia digital · Ecuador</span>
      <h1 class="hero__titulo">
        Tu negocio merece<br />
        <span class="hero__acento">una web que venda.</span>
      </h1>
      <p class="hero__sub">
        La construimos en días, no en meses, y la conectamos con
        automatización de ventas por WhatsApp.
      </p>
      <div class="hero__cta">
        <WhatsAppButton
          phone={site.telefonoWhatsApp}
          message="Hola Vorka, quiero información"
          negocioSlug={site.negocioSlug}
          label="Hablemos por WhatsApp →"
          variante="primario"
        />
        <a class="hero__cta-secundario" href="#portafolio">Ver ejemplos →</a>
      </div>
      <ul class="hero__proof" aria-label="Garantías de servicio">
        <li><span class="hero__proof-check" aria-hidden="true">✓</span> Respuesta en menos de 2 horas</li>
        <li><span class="hero__proof-check" aria-hidden="true">✓</span> Web lista en 5–7 días</li>
        <li><span class="hero__proof-check" aria-hidden="true">✓</span> Sin contratos largos</li>
      </ul>
    </div>

    <!-- Composición de 2 dispositivos (rediseño 2026-07; TAREA 1 2026-07-27):
         el teléfono ya no muestra un wireframe gris neutro — muestra una versión
         CODIFICADA y fiel del hero móvil de los 3 demos reales, rotando (ver
         HeroPhonePreview.astro). El frame + notch + la tarjeta de chat de
         WhatsApp superpuesta siguen siendo de Capa 1. La tarjeta de chat se
         sincroniza con el demo activo (nombre + color del avatar) desde
         HeroPhonePreview. NO lleva `reveal--scale`: el fade/scale de Capa 1
         retrasaría el pintado hasta el IntersectionObserver; la entrada del
         mockup ya la orquesta la secuencia .is-ready del propio hero, y el <h1>
         sigue siendo el candidato a LCP (las previews son livianas y diferidas). -->
    <div class="hero__mockup" aria-hidden="true">
      <div class="hero__telefono">
        <span class="hero__telefono-notch"></span>
        <div class="hero__pantalla">
          <HeroPhonePreview />
        </div>
      </div>

      <div class="hero__chat">
        <div class="hero__chat-cabecera">
          <span class="hero__chat-avatar" style={`background:${chatDemoInicial.colores.primario};`}></span>
          <div class="hero__chat-info">
            <span class="hero__chat-nombre">{chatDemoInicial.nombre}</span>
            <span class="hero__chat-estado">en línea</span>
          </div>
        </div>
        <p class="hero__chat-burbuja hero__chat-burbuja--entrante">Hola! Vi tu web, quiero hacer un pedido</p>
        <p class="hero__chat-burbuja hero__chat-burbuja--saliente">¡Con gusto! Dime qué necesitas y lo confirmamos ✅</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Dispara la entrada orquestada tras el primer pintado. El doble rAF asegura
  // que el navegador pinte el estado inicial (gateado por .js-reveal) antes de
  // añadir .is-ready, para que las transiciones corran sin flash. Primer load
  // únicamente — no se re-observa nada.
  const hero = document.querySelector('.hero');
  if (hero) {
    requestAnimationFrame(() =>
      requestAnimationFrame(() => hero.classList.add('is-ready')),
    );
  }
</script>

<style>
  .hero {
    padding-top: 96px;
    padding-bottom: 96px;
    background: linear-gradient(180deg, var(--color-fondo) 0%, var(--color-fondo-alterno) 100%);
    text-align: center;
  }

  /* Sprint 2 T6 — entrada orquestada. Estado inicial gateado por .js-reveal +
     :not(.is-ready): se aplica antes del primer pintado (sin flash) y deja de
     aplicar en cuanto el JS añade .is-ready, disparando la transición hacia el
     estado natural con un retardo escalonado por elemento. Solo transform/
     opacity → sin reflujo ni CLS. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-reveal) .hero:not(.is-ready) .hero__badge,
    :global(.js-reveal) .hero:not(.is-ready) .hero__sub,
    :global(.js-reveal) .hero:not(.is-ready) .hero__proof,
    :global(.js-reveal) .hero:not(.is-ready) .hero__mockup {
      opacity: 0;
      transform: translateY(16px);
    }

    /* El titulo (candidato a LCP) y el .hero__cta (botón de WhatsApp, CTA
       sagrado) NUNCA bajan opacity: se pintan visibles desde el primer frame y
       solo se desplazan. */
    :global(.js-reveal) .hero:not(.is-ready) .hero__titulo,
    :global(.js-reveal) .hero:not(.is-ready) .hero__cta {
      transform: translateY(16px);
    }

    .hero__badge,
    .hero__titulo,
    .hero__sub,
    .hero__cta,
    .hero__proof,
    .hero__mockup {
      transition: opacity var(--duration-reveal) var(--ease-out-expo),
        transform var(--duration-reveal) var(--ease-out-expo);
    }

    /* Secuencia: badge → titulo → sub → mockup → cta → proof. */
    .hero.is-ready .hero__badge {
      transition-delay: 80ms;
    }
    .hero.is-ready .hero__titulo {
      transition-delay: 160ms;
    }
    .hero.is-ready .hero__sub {
      transition-delay: 240ms;
    }
    .hero.is-ready .hero__mockup {
      transition-delay: 280ms;
    }
    .hero.is-ready .hero__cta {
      transition-delay: 320ms;
    }
    .hero.is-ready .hero__proof {
      transition-delay: 400ms;
    }
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .hero__contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 760px;
  }

  .hero__mockup {
    position: relative;
    display: flex;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero__telefono {
    /* 40px: bezel de teléfono, geometría de dispositivo físico — no forma
       parte de la escala r-sm/r-md/r-full (ver nota en index.astro). */
    position: relative;
    width: 264px;
    padding: 12px;
    border-radius: 40px;
    background: #0d0d0d;
    border: 1px solid var(--border-default);
    box-shadow: var(--accent-glow);
  }

  .hero__telefono-notch {
    position: absolute;
    top: 22px;
    left: 50%;
    transform: translateX(-50%);
    width: 88px;
    height: 8px;
    border-radius: var(--r-full);
    background: var(--border-default);
    z-index: 1;
  }

  .hero__pantalla {
    /* 28px: bezel interior de la pantalla, misma excepción documentada que
       .hero__telefono arriba — geometría de dispositivo, no forma parte de
       la escala r-sm/r-md/r-full. Fondo blanco a propósito (visible mientras
       carga la primera preview). position:relative + aspect-ratio fijo →
       contexto y dimensiones reservadas para los slides absolutos de
       HeroPhonePreview (CLS 0). */
    position: relative;
    width: 100%;
    aspect-ratio: 240 / 430;
    border-radius: 28px;
    background: #ffffff;
    overflow: hidden;
  }

  .hero__chat {
    /* Flota sobre la FOTO (zona media-baja del teléfono), no sobre el pie:
       desde TAREA 1 la pantalla muestra el hero real del demo con su tagline +
       CTA abajo, así que la tarjeta se sube para no taparlos (antes el fondo
       era un wireframe gris sin contenido que tapar). */
    position: absolute;
    right: -20px;
    bottom: 150px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 176px;
    padding: 12px;
    border-radius: var(--r-md);
    background: #ffffff;
    box-shadow: var(--shadow-elevar);
  }

  .hero__chat-cabecera {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid #ececec;
  }

  .hero__chat-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    /* Color inicial en el markup (SSR = demo activo); HeroPhonePreview lo
       cambia por JS en cada rotación, aquí solo se anima la transición. */
    background: var(--color-primario);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__chat-avatar {
      transition: background-color var(--duration-reveal) var(--ease-out-expo);
    }
  }

  .hero__chat-info {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .hero__chat-nombre {
    font-family: var(--font-texto);
    font-size: 11px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .hero__chat-estado {
    /* #25d366: verde "en línea" oficial de la UI de WhatsApp — igual que en
       WhatsAppFlotante.astro, no themeable. */
    font-family: var(--font-texto);
    font-size: 10px;
    color: #25d366;
  }

  .hero__chat-burbuja {
    margin: 0;
    padding: 6px 10px;
    max-width: 88%;
    border-radius: 10px;
    font-family: var(--font-texto);
    font-size: 11px;
    line-height: 1.4;
    color: #1a1a1a;
  }

  .hero__chat-burbuja--entrante {
    align-self: flex-start;
    background: #f0f0f0;
    border-bottom-left-radius: 2px;
  }

  .hero__chat-burbuja--saliente {
    /* #dcf8c6: verde de burbuja saliente de la UI real de WhatsApp —
       excepción de marca, no forma parte de la paleta temática de Vorka. */
    align-self: flex-end;
    background: #dcf8c6;
    border-bottom-right-radius: 2px;
  }

  @media (max-width: 720px) {
    .hero__chat {
      width: 144px;
      right: -12px;
      bottom: 132px;
    }
  }

  @media (min-width: 961px) {
    .hero__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }

    .hero__contenido {
      align-items: flex-start;
      max-width: 620px;
    }

    .hero__cta {
      justify-content: flex-start;
    }

    .hero__proof {
      justify-content: flex-start;
    }
  }

  .hero__badge {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--color-primario);
    border-radius: var(--r-full);
    color: var(--color-primario);
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero__titulo {
    font-family: var(--font-titulos);
    font-weight: 700;
    font-size: var(--t-display);
    line-height: 1.1;
    color: var(--color-texto);
    margin: 0;
  }

  .hero__acento {
    color: var(--color-primario);
  }

  .hero__sub {
    font-family: var(--font-texto);
    font-size: var(--t-md);
    line-height: 1.7;
    color: var(--color-gris);
    max-width: 560px;
    margin: 0;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 8px;
  }

  .hero__cta-secundario {
    font-family: var(--font-texto);
    font-weight: 600;
    color: var(--color-texto);
    text-decoration: none;
    opacity: 0.75;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity 200ms ease;
  }

  .hero__cta-secundario:hover {
    opacity: 1;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .hero__proof li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-texto);
    font-size: var(--t-sm);
    color: var(--color-gris);
  }

  .hero__proof-check {
    color: var(--color-primario);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 64px;
      padding-bottom: 64px;
    }
  }
</style>
