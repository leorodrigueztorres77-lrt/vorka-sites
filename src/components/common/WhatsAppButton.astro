---
// Capa 1 — botón de WhatsApp reutilizable con tracking. Cualquier vertical
// pasa su propio mensaje pre-cargado; el link y el tracking no cambian.
import { buildWhatsAppLink } from '@/lib/whatsapp';

interface Props {
  phone: string;
  message: string;
  negocioSlug: string;
  label?: string;
  variante?: 'primario' | 'acento';
}

const {
  phone,
  message,
  negocioSlug,
  label = 'Escríbenos por WhatsApp',
  variante = 'primario',
} = Astro.props;

const href = buildWhatsAppLink({ phone, message, negocioSlug });

// Sprint 2 T2 (Vorka, 2026-07-24): si el label termina en una flecha, se
// separa en un <span class="btn__flecha"> para que sea animable (desplazarla
// en hover). Cambio aditivo y puramente estructural de Capa 1: el render es
// idéntico en todos los sitios; el MOVIMIENTO de la flecha lo activa cada
// página por su cuenta (hoy solo Vorka lo scopea), así que los demos de
// cliente entregados no se mueven.
const flechaMatch = label.match(/^(.*?)\s*(→)\s*$/);
const textoLabel = flechaMatch ? flechaMatch[1] : label;
const flecha = flechaMatch ? flechaMatch[2] : null;
---

<a
  class={`btn btn--${variante}`}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  {textoLabel}{flecha && <span class="btn__flecha" aria-hidden="true">{flecha}</span>}
</a>
